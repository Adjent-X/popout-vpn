###############################################################################
# Popout VPN — global application config
# Copy to config/app.env and edit. The installer writes a filled copy.
#
# VPN-only (tun0 / 10.8.0.1): bind the reverse proxy there, TURNSTILE_ENABLED=false
# Public WAN via Cloudflare + Nginx: set PUBLIC_CLOUDFLARE_FRONTEND_URL
###############################################################################

APP_MODE=production
ENVIRONMENT=production
DEBUG=false
APP_VERSION=0.1.0
GITHUB_REPO=popout-vpn/popout-vpn

BACKEND_BIND_HOST=127.0.0.1
BACKEND_BIND_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_PORT=3000

# What browsers see (scheme + host). Leave PUBLIC_API_URL empty for same-origin /api.
PUBLIC_FRONTEND_URL=http://10.8.0.1
PUBLIC_API_URL=
PUBLIC_CLOUDFLARE_FRONTEND_URL=

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=popout_vpn
MONGODB_USER=popout
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# REQUIRED in production: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BRAND_NAME=Popout
BRAND_PRODUCT=VPN
SITE_TITLE="Popout VPN Admin"
BRAND_COLOR_BG="#0a0e14"
BRAND_COLOR_PRIMARY="#1e3a8a"
BRAND_COLOR_ACCENT="#06b6d4"
BRAND_COLOR_ACCENT_BRIGHT="#67e8f9"

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_EMAIL_REQUESTS=5
AUTH_RATE_LIMIT_EMAIL_WINDOW_SECONDS=300

# Seeded only if Mongo has zero admins. The installer generates these.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

REGISTRATION_TOKEN_TTL_HOURS=24

OPENVPN_FLAVOR=auto
EASYRSA_PATH=/etc/openvpn/server/easy-rsa
EASYRSA_BIN=./easyrsa
OPENVPN_CLIENT_COMMON_PATH=/etc/openvpn/server/client-common.txt
OPENVPN_CA_CERT_PATH=/etc/openvpn/server/ca.crt
OPENVPN_TLS_CRYPT_KEY_PATH=/etc/openvpn/server/tc.key
OPENVPN_TLS_CRYPT_V2_KEY_PATH=
OPENVPN_SERVER_HOST=vpn.example.com
OPENVPN_SERVER_PORT=1194
OPENVPN_PROTO=udp4
OPENVPN_CRL_PATH=/etc/openvpn/server/crl.pem
OPENVPN_CRL_OWNER=nobody
OPENVPN_CRL_GROUP=nogroup
OPENVPN_RELOAD_CMD=
OPENVPN_STATUS_PATH=/etc/openvpn/server/openvpn-status.log
OPENVPN_IPP_PATH=/etc/openvpn/server/ipp.txt
OPENVPN_CLIENT_EVENTS_PATH=/var/log/openvpn/client-events.log
CONFIG_EXPIRING_SOON_DAYS=7
CONFIG_EXPIRY_CHECK_INTERVAL_MINUTES=15
METRICS_POLL_SECONDS=30
CONNECTION_POLL_SECONDS=15
METRICS_RETENTION_HOURS=24

ATTACK_PCAP_DIR=/var/log/popout-vpn/captures
ATTACK_EVENTS_DIR=/var/log/popout-vpn/events
BACKUP_DIR=/root/backups
PANEL_ROOT=/opt/popout-vpn
BACKUP_INTERVAL_MINUTES=30
BACKUP_KEEP_COUNT=3

APP_NAME="Popout VPN Admin API"
