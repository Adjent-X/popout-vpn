# Generated/overwritten from config/app.env by the installer.

APP_NAME=Popout VPN Admin API
ENVIRONMENT=production
DEBUG=false
APP_VERSION=0.1.0

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=popout_vpn
MONGODB_USER=popout
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ALLOWED_ORIGINS=https://admin.example.com

EASYRSA_PATH=/etc/openvpn/server/easy-rsa
OPENVPN_SERVER_HOST=vpn.example.com
OPENVPN_SERVER_PORT=1194
OPENVPN_PROTO=udp4
PANEL_ROOT=/opt/popout-vpn
